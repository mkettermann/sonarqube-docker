# Copie para `.env` e preencha. O `.env` NÃO é versionado.
# Lido pelo `docker compose` (porta, imagem, senha do banco) e pelo `sonar-local`
# (porta, senha do admin, imagem do scanner).

# Porta do painel no host (publicada só em 127.0.0.1).
SONAR_PORT=9000

# Senha que o `sonar-local` define para o usuário `admin` no primeiro uso (o Sonar
# obriga trocar o `admin`/`admin` padrão). Regras do Sonar: 12+ caracteres, com
# maiúscula, minúscula, número e caractere especial. É a senha do login no painel.
SONAR_ADMIN_PASSWORD=

# Senha do Postgres do Sonar (só acessível dentro da rede do Docker).
SONAR_DB_PASSWORD=sonar

# Imagens. Fixe uma versão (tag `<versão>-community` do Docker Hub) se quiser
# controlar quando atualizar — ver docs/operacao.md, "Atualizar o SonarQube".
SONARQUBE_IMAGE=sonarqube:community
SONAR_SCANNER_IMAGE=sonarsource/sonar-scanner-cli:latest
