{
	"name": "sonarqube-docker",
	"version": "2.0.0",
	"private": true,
	"description": "SonarQube local compartilhado entre os projetos da máquina + CLI sonar-local.",
	"type": "module",
	"bin": {
		"sonar-local": "dist/bin/sonar-local.js"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"prepare": "npm run build",
		"typecheck": "tsc",
		"test": "node --test \"test/**/*.test.ts\"",
		"check": "npm run typecheck && npm test",
		"up": "docker compose up -d",
		"down": "docker compose down",
		"logs": "docker compose logs -f sonarqube",
		"status": "node src/bin/sonar-local.ts status"
	},
	"devDependencies": {
		"@types/node": "^24.19.2",
		"typescript": "^7.0.2"
	},
	"engines": {
		"node": ">=24"
	}
}
